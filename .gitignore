# --- This project: data is NEVER committed ---
# Anchor to repo root with a leading slash so the rule excludes only
# the top-level data/ warehouse directory, NOT the `src/nfl_model/data/`
# Python package (the warehouse + ingestors + pipeline SOURCE CODE).
# Without the leading slash, .gitignore matches `data/` at any depth
# and silently drops the entire data layer — which is exactly how the
# original v1.0.0 release shipped without it.
/data/
!/data/.gitkeep
*.parquet
*.duckdb
*.duckdb.wal
*.csv
!data_dictionary*.csv

# --- Models ---
/models/
*.pkl
*.joblib
*.lgb
*.xgb

# --- Logs ---
/logs/
*.log

# --- End-of-season reports (generated annually) ---
/reports/
!/reports/.gitkeep

# --- Secrets ---
secrets.toml
*.pem
*.key
.env.odds_api

# --- macOS .app bundle ---
NFL Forecast.app/

# --- Transfer tarballs ---
nfl-model-transfer-*.tar.gz
